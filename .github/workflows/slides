      - name: Build latest lecture + 3 previous
        shell: bash
        run: |
          set -euo pipefail

          REPO_NAME="${{ github.event.repository.name }}"
          OUT_DIR="site"
          rm -rf "$OUT_DIR"
          mkdir -p "$OUT_DIR"

          # Find Lektion folders that contain slidev/package.json, extract lecture number,
          # sort by number, keep last 4.
          mapfile -t ENTRIES < <(
            find . -type f -path "./Lektion */slidev/package.json" -print \
            | while read -r pkg; do
                # pkg: ./Lektion 14/slidev/package.json
                lesson_dir="$(dirname "$(dirname "$pkg")")"   # ./Lektion 14
                lesson_name="$(basename "$lesson_dir")"       # Lektion 14
                # extract number (handles "Lektion 14", "Lektion 014", etc.)
                num="$(echo "$lesson_name" | sed -E 's/[^0-9]*([0-9]+).*/\1/')"
                slidev_dir="$(dirname "$pkg")"                # ./Lektion 14/slidev
                printf "%06d\t%s\t%s\n" "$num" "$lesson_name" "$slidev_dir"
              done \
            | sort -n \
            | tail -n 4
          )

          if [ "${#ENTRIES[@]}" -eq 0 ]; then
            echo "No Slidev projects found under './Lektion */slidev'."
            exit 1
          fi

          echo "Building these lectures (latest 4):"
          printf '%s\n' "${ENTRIES[@]}" | sed 's/\t/ | /g'

          # Index
          INDEX_FILE="$OUT_DIR/index.html"
          cat > "$INDEX_FILE" <<'HTML'
          <!doctype html>
          <html lang="da">
          <head>
            <meta charset="utf-8" />
            <meta name="viewport" content="width=device-width,initial-scale=1" />
            <title>Slides</title>
            <style>
              body { font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif; margin: 2rem; }
              h1 { margin-bottom: 1rem; }
              ul { line-height: 1.9; padding-left: 1.2rem; }
              a { text-decoration: none; }
              a:hover { text-decoration: underline; }
              .hint { color: #666; font-size: .95rem; margin-top: .5rem; }
            </style>
          </head>
          <body>
            <h1>Slides</h1>
            <ul>
          HTML

          for entry in "${ENTRIES[@]}"; do
            IFS=$'\t' read -r num lesson_name slidev_dir <<< "$entry"

            # slug like "lektion-14"
            slug="$(echo "$lesson_name" | tr '[:upper:]' '[:lower:]' | sed -E 's/[[:space:]]+/-/g')"

            echo ""
            echo "==> Building: $lesson_name ($slidev_dir) -> /$REPO_NAME/$slug/"

            npm ci --prefix "$slidev_dir"
            npm run build --prefix "$slidev_dir" -- --base "/$REPO_NAME/$slug/"

            mkdir -p "$OUT_DIR/$slug"
            rsync -a --delete "$slidev_dir/dist/" "$OUT_DIR/$slug/"

            echo "              <li><a href=\"./$slug/\">$lesson_name</a></li>" >> "$INDEX_FILE"
          done

          cat >> "$INDEX_FILE" <<'HTML'
            </ul>
            <p class="hint">Viser seneste lektion + tre foregående.</p>
          </body>
          </html>
          HTML
